{
  "analysis": {
    "analyzer": {
      "serbian_simple": {
        "type": "custom",
        "tokenizer": "icu_tokenizer",
        "filter": ["serbian_cyrillic_to_latinic", "lowercase"]
      },
      "ukrainian": {
        "type": "custom",
        "tokenizer": "standard",
        "filter": ["ukrainian_stemmer", "icu_folding", "lowercase"]
      }
    },
    "filter": {
      "serbian_cyrillic_to_latinic": {
        "type": "icu_transform",
        "id": "Cyrillic-Latin; NFD; [:Nonspacing Mark:] Remove; NFC"
      },
      "ukrainian_stemmer": {
        "type": "stemmer",
        "language": "russian"
      }
    }
  }
}