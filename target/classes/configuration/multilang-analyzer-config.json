{
  "analysis": {

    "char_filter": {
      "russian_yo_normalizer": {
        "type": "mapping",
        "mappings": [
          "ё => е",
          "Ё => Е"
        ]
      }
    },

    "analyzer": {

      "italian": {
        "type": "custom",
        "tokenizer": "icu_tokenizer",
        "filter": ["italian_elision", "lowercase", "icu_normalizer", "italian_stop", "italian_synonyms", "italian_stemmer", "icu_folding"]
      },

      "portuguese": {
        "type": "custom",
        "tokenizer": "icu_tokenizer",
        "filter": ["lowercase", "icu_normalizer", "portuguese_stop", "portuguese_stemmer", "icu_folding"]
      },

      "french": {
        "type": "custom",
        "tokenizer": "icu_tokenizer",
        "filter": ["french_elision", "icu_normalizer", "lowercase", "french_stop", "french_keywords", "french_synonyms", "french_stemmer", "icu_folding"]
      },

      "spanish": {
        "type": "custom",
        "tokenizer": "icu_tokenizer",
        "filter": ["lowercase", "icu_normalizer", "spanish_stop", "spanish_stemmer", "icu_folding"]
      },

      "english": {
        "type": "custom",
        "tokenizer": "icu_tokenizer",
        "filter": ["icu_normalizer", "lowercase", "english_possessive_stemmer", "english_stop", "english_keywords", "english_synonyms", "english_stemmer", "icu_folding"]
      },

      "german": {
        "type": "custom",
        "tokenizer": "icu_tokenizer",
        "filter": ["lowercase", "german_normalization", "german_stop", "german_synonyms", "german_stemmer", "icu_folding"]
      },

      "russian_indexing": {
        "type": "custom",
        "tokenizer": "icu_tokenizer",
        "char_filter": [
          "russian_yo_normalizer"
        ],
        "filter": ["lowercase", "icu_normalizer", "russian_stop", "russian_keywords", "russian_stemmer", "russian_cyrillic_to_latinic"]
      },

      "russian_searching": {
        "type": "custom",
        "tokenizer": "icu_tokenizer",
        "char_filter": [
          "russian_yo_normalizer"
        ],
        "filter": ["lowercase", "icu_normalizer", "russian_synonyms", "russian_stop", "russian_keywords", "russian_stemmer", "russian_cyrillic_to_latinic"]
      },

      "serbian_simple": {
        "type": "custom",
        "tokenizer": "icu_tokenizer",
        "filter": ["lowercase", "icu_normalizer", "serbian_stop", "serbian_keywords", "serbian_stemmer", "serbian_cyrillic_to_latinic"]
      },

      "ukrainian": {
        "type": "custom",
        "tokenizer": "icu_tokenizer",
        "filter": ["lowercase", "icu_normalizer", "ukrainian_stop", "ukrainian_cyrillic_to_latinic", "icu_folding"]
      }
    },

    "filter": {

      "serbian_stemmer": {
        "type": "stemmer",
        "language": "serbian"
      },

      "serbian_stop": {
        "type": "stop",
        "stopwords": "_serbian_"
      },

      "serbian_keywords": {
        "type": "keyword_marker",
        "keywords": []
      },

      "russian_synonyms": {
        "type": "synonym_graph",
        "synonyms": [
          "rf, rossiiskaia federatsiia, matushka, рф, матушка, российская федерация",
          "sssr, sovetskii soiuz, ссср, советский союуз",
          "rssr, rsfsr, rosiiskaia respublika, rossiia, рсср, рсфср, российская республика, россия",
          "ussr, ukrainskaia respublika, ukraina, украина, украинская республика, усср",
          "spb, sankt-peterburg, sankt peterburg, petersburg, petersbourg, piter, leningrad, спб, санкт-петербург, питер, ленинград",
          "babki, dengi, бабки, деньги"
        ]
      },

      "russian_stemmer": {
        "type": "stemmer",
        "language": "russian"
      },

      "russian_stop": {
        "type": "stop",
        "stopwords": "_russian_"
      },

      "russian_keywords": {
        "type": "keyword_marker",
        "keywords": []
      },

      "serbian_cyrillic_to_latinic": {
        "type": "icu_transform",
        "id": "Cyrillic-Latin; NFD; [:Nonspacing Mark:] Remove; NFC"
      },

      "russian_cyrillic_to_latinic": {
        "type": "icu_transform",
        "id": "Cyrillic-Latin; NFD; [:Nonspacing Mark:] Remove; NFC"
      },

      "ukrainian_cyrillic_to_latinic": {
        "type": "icu_transform",
        "id": "Cyrillic-Latin; NFD; [:Nonspacing Mark:] Remove; NFC"
      },

      "ukrainian_stop": {
        "type": "stop",
        "stopwords": "_ukrainian_"
      },


      "german_stop": {
        "type": "stop",
        "stopwords": "_german_"
      },
      "german_stemmer": {
        "type": "stemmer",
        "language": "light_german"
      },
      "german_synonyms": {
        "type": "synonym_graph",
        "synonyms": [
          "pkw, auto, wagen, fahrzeug",
          "handy, mobiltelefon, smartphone",
          "uni, universitat, universitaet"
        ]
      },

      "english_stop": {
        "type": "stop",
        "stopwords": "_english_"
      },
      "english_keywords": {
        "type": "keyword_marker",
        "keywords": []
      },
      "english_synonyms": {
        "type": "synonym_graph",
        "synonyms": []
      },
      "english_stemmer": {
        "type": "stemmer",
        "language": "light_english"
      },
      "english_possessive_stemmer": {
        "type": "stemmer",
        "language": "possessive_english"
      },

      "french_elision": {
        "type": "elision",
        "articles_case": true,
        "articles": [
          "l","m","t","qu","n","s","j","d","c","jusqu","quoiqu","lorsqu","puisqu"
        ]
      },
      "french_stop": {
        "type": "stop",
        "stopwords": "_french_"
      },
      "french_keywords": {
        "type": "keyword_marker",
        "keywords": []
      },
      "french_synonyms": {
        "type": "synonym_graph",
        "synonyms": [
          "computer, computeur, ordinateur",
          "fric, argent",
          "uni, universite",
          "car, voiture, wagon, vehicule, auto"
        ]
      },
      "french_stemmer": {
        "type": "stemmer",
        "language": "light_french"
      },

      "spanish_stop": {
        "type": "stop",
        "stopwords": "_spanish_"
      },
      "spanish_stemmer": {
        "type": "stemmer",
        "language": "light_spanish"
      },

      "italian_elision": {
        "type": "elision",
        "articles_case": true,
        "articles": [
          "c","l","all","dall","dell","nell","sull","coll","pell","gl","agl","dagl","degl","negl","sugl","un","m","t","s","v","d"
        ]
      },
      "italian_stop": {
        "type": "stop",
        "stopwords": "_italian_"
      },
      "italian_synonyms": {
        "type": "synonym_graph",
        "synonyms": [
          "auto, automobile, macchina",
          "cellulare, telefono"
        ]
      },
      "italian_stemmer": {
        "type": "stemmer",
        "language": "light_italian"
      },

      "portuguese_stop": {
        "type": "stop",
        "stopwords": "_portuguese_"
      },
      "portuguese_stemmer": {
        "type": "stemmer",
        "language": "light_portuguese"
      }
    }
  }
}